{
  "name": "securevisit-prototype",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "test": "npm run build && node --import tsx --test",
    "test:e2e": "playwright test",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit --incremental false",
    "validate:environment": "node --import tsx --env-file-if-exists=.env.local scripts/validate-environment.mjs",
    "db:migrate:local": "node --env-file-if-exists=.env.local scripts/d1-migrations.mjs apply --local",
    "db:migrate:remote": "node --env-file-if-exists=.env.local scripts/d1-migrations.mjs apply --remote",
    "db:migrations:list:local": "node --env-file-if-exists=.env.local scripts/d1-migrations.mjs list --local",
    "db:migrations:list": "node --env-file-if-exists=.env.local scripts/d1-migrations.mjs list --remote",
    "db:seed:local": "node --env-file-if-exists=.env.local scripts/d1-migrations.mjs seed --local",
    "db:test:migrations:local": "node scripts/test-local-migrations.mjs"
  },
  "dependencies": {
    "@node-saml/node-saml": "^5.1.0",
    "drizzle-orm": "0.45.2",
    "livekit-client": "^2.22.0",
    "livekit-server-sdk": "^2.17.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.57.1",
    "@cloudflare/workers-types": "5.20260922.1",
    "@playwright/test": "^1.55.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.5",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "tsx": "4.22.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.3.0",
    "wrangler": "4.136.1"
  },
  "overrides": {
    "image-size": "2.0.3"
  },
  "type": "module"
}
