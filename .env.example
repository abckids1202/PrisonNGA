# Live Session provider configuration. Keep the API secret server-side only.
# Fresh local development uses the persisted no-media transport so the
# appointment -> Waiting Room -> Live Session state flow can be exercised
# without pretending that a real provider is connected. Staging/production
# must set VIDEO_PROVIDER=livekit and provide real credentials.
VIDEO_PROVIDER=local_test
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# SecureVisit server-side security configuration.
SECUREVISIT_HASH_SALT=

# Set only for remote D1 migration commands. Use the real UUID from Cloudflare.
D1_DATABASE_ID=
D1_DATABASE_NAME=securevisit
# Non-development builds must provide the real R2 bucket name so the generated
# Worker manifest contains the EVIDENCE_BUCKET binding.
EVIDENCE_BUCKET_NAME=

# Visitor auth delivery adapter. `console` exposes a devCode in local responses;
# production must use a real email/SMS provider and never return the code.
# The initial pilot is email-first. Keep SMS disabled unless the institution
# explicitly approves it and the SMS provider has passed staging verification.
# Non-development environments still require the approval attestation below.
VISITOR_AUTH_CHANNELS=EMAIL
SECUREVISIT_VISITOR_EMAIL_ONLY_APPROVAL=
VISITOR_AUTH_DELIVERY=console
VISITOR_AUTH_WEBHOOK_URL=
VISITOR_AUTH_WEBHOOK_SECRET=
# Optional direct adapters. In staging/production choose `resend` for email
# and/or `twilio` for SMS, or leave both blank and use the signed webhook above.
VISITOR_EMAIL_DELIVERY=
VISITOR_SMS_DELIVERY=
RESEND_API_KEY=
VISITOR_EMAIL_FROM=SecureVisit <no-reply@example.com>
VISITOR_SMS_TWILIO_ACCOUNT_SID=
VISITOR_SMS_TWILIO_AUTH_TOKEN=
VISITOR_SMS_TWILIO_FROM=
VISITOR_SMS_TWILIO_MESSAGING_SERVICE_SID=
SECUREVISIT_ENVIRONMENT=development
SECUREVISIT_RELEASE_ID=local
# Optional immutable CI/deployment identifier exposed by readiness diagnostics.
SECUREVISIT_BUILD_ID=
# Required in staging/production; development uses the current local origin.
PUBLIC_APP_URL=http://localhost:5174
# Vercel-only public origin for the authoritative Cloudflare Worker API.
# Leave blank for local development; Vercel staging/production must set this
# to the Worker HTTPS origin without a path, query, fragment, or credentials.
WORKER_API_ORIGIN=
# Staging smoke target; keep this separate from the local application URL.
STAGING_DOMAIN=https://staging.your-securevisit-domain.example
# Supply a short-lived authenticated staff session cookie only when running the readiness gate.
STAGING_READINESS_COOKIE=
STAGING_SMOKE_REQUIRE_READINESS=true
STAGING_SMOKE_ALLOW_INSECURE=false
STAGING_SMOKE_TIMEOUT_MS=10000
PAYMENT_PROVIDER=local_test
# For staging/production choose `xendit` or keep `webhook` for an approved
# provider gateway. Xendit requires XENDIT_SECRET_KEY and uses the hosted
# Payment Session API; it remains disabled until webhook normalization is ready.
XENDIT_SECRET_KEY=
XENDIT_API_BASE_URL=https://api.xendit.co
XENDIT_WEBHOOK_TOKEN=
PAYMENT_CHECKOUT_URL=
PAYMENT_REFUND_URL=
PAYMENT_PROVIDER_SECRET=
# Development-only deterministic signing secret; staging/production must use a separately managed secret.
PAYMENT_WEBHOOK_SECRET=local-development-payment-webhook-secret-0123456789
# Development example price per Visit Credit in IDR minor units; set the approved facility price before staging/production.
VISIT_CREDIT_PRICE_MINOR=50000
NOTIFICATION_DELIVERY=in_app
NOTIFICATION_EMAIL_DELIVERY=
NOTIFICATION_SMS_DELIVERY=
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_SECRET=
# Signed provider status relay used for delivery/bounce/invalid-recipient callbacks.
NOTIFICATION_STATUS_WEBHOOK_SECRET=
# Optional Cloudflare Queue for outbox draining. Leave empty locally; cron remains the fallback.
NOTIFICATION_QUEUE_NAME=

# Staff federation boundary. Staging/production require both OIDC and SAML
# paths, each with its institutional MFA claim configuration.
STAFF_AUTH_PROVIDER=none
STAFF_OIDC_ISSUER=
STAFF_OIDC_CLIENT_ID=
STAFF_OIDC_CLIENT_SECRET=
STAFF_OIDC_REDIRECT_URI=https://your-securevisit-host.example/api/auth/staff/oidc/callback
STAFF_OIDC_EXPECTED_AUDIENCE=
# Production/staging must require an IdP MFA claim. Set one or both to the institution's values.
STAFF_OIDC_MFA_ACR=
STAFF_OIDC_MFA_AMR=mfa
STAFF_SAML_ENTITY_ID=
STAFF_SAML_METADATA_URL=
STAFF_SAML_ENTRY_POINT=
STAFF_SAML_IDP_CERT=
STAFF_SAML_CALLBACK_URI=https://your-securevisit-host.example/api/auth/staff/saml/callback
STAFF_SAML_MFA_ACR=urn:oasis:names:tc:SAML:2.0:ac:classes:TimeSyncToken
STAFF_STEP_UP_SECRET=
# Platform bootstrap secret; store only in Cloudflare secret bindings, never in Worker vars or Vercel.
PLATFORM_PROVISIONING_SECRET=
EVIDENCE_RETENTION_DAYS=365
# Staging/production must use protected Cloudflare R2 evidence storage.
EVIDENCE_STORAGE_PROVIDER=local_test
# Staging/production must use an HTTPS malware-scanning adapter. Development may use `development`.
EVIDENCE_SCAN_PROVIDER=development
EVIDENCE_SCAN_WEBHOOK_URL=
EVIDENCE_SCAN_WEBHOOK_SECRET=
# Optional callback URL for asynchronous scanner adapters, normally
# https://<public-domain>/api/webhooks/evidence-scan.
EVIDENCE_SCAN_CALLBACK_URL=
# Recording output is kept in a separate private R2 bucket from identity evidence.
RECORDINGS_BUCKET_NAME=
RECORDING_STORAGE_PROVIDER=livekit_r2
# R2-managed encryption at rest; LiveKit's S3Upload contract does not expose
# customer-managed SSE/KMS fields, so do not represent this as a fake key.
RECORDINGS_ENCRYPTION_MODE=r2_managed
# Non-secret identifier for the storage encryption control/key policy.
RECORDINGS_ENCRYPTION_KEY_REFERENCE=
R2_S3_ENDPOINT=
R2_S3_REGION=auto
R2_S3_ACCESS_KEY_ID=
R2_S3_SECRET_ACCESS_KEY=

# Production release attestations must reference a named evidence manifest and
# expire; readiness rejects missing, malformed, or stale release evidence.
SECUREVISIT_RELEASE_EVIDENCE_ID=
SECUREVISIT_RELEASE_EVIDENCE_EXPIRES_AT=
# JSON manifest containing matching releaseId/expiresAt plus one named,
# unexpired evidence record for every production release gate.
SECUREVISIT_RELEASE_EVIDENCE_MANIFEST=
# Staging uses a separate evidence manifest for the pilot acceptance gates.
# It must contain the matching staging releaseId/expiresAt and one evidence
# record for every pilot gate; production uses the RELEASE_EVIDENCE_* fields.
SECUREVISIT_STAGING_EVIDENCE_ID=
SECUREVISIT_STAGING_EVIDENCE_EXPIRES_AT=
SECUREVISIT_STAGING_EVIDENCE_MANIFEST=

# Pilot and production evidence attestations. Keep values short and reference
# the signed evidence record stored by the institution; do not put secrets or
# personal data in these variables. Staging requires the *_STAGING values;
# production additionally requires the release approval/review values above
# and the expiring evidence manifest.
SECUREVISIT_RELEASE_APPROVAL=
SECUREVISIT_SECURITY_REVIEW=
SECUREVISIT_PRIVACY_REVIEW=
SECUREVISIT_TARIFF_APPROVAL=
SECUREVISIT_REFUND_POLICY_APPROVAL=
SECUREVISIT_BACKUP_RESTORE_DRILL=
SECUREVISIT_WAF=
SECUREVISIT_MONITORING=
SECUREVISIT_OUTAGE_RUNBOOK=
SECUREVISIT_IDENTITY_STAGING=
SECUREVISIT_PAYMENT_STAGING=
SECUREVISIT_NOTIFICATION_STAGING=
SECUREVISIT_EVIDENCE_STAGING=
SECUREVISIT_KIOSK_STAGING=
SECUREVISIT_LIVEKIT_STAGING=

# Production refuses to start unless these platform bindings and provider values are configured.
# EVIDENCE_BUCKET is a Cloudflare R2 binding, not a secret value.
